# ENCLOSURE HANDLING
######################################################################

def map_enclosures():
    Debug("ENTER: map_enclosures")
    raw = parse_lsscsi_enclosures()

    dedup = {}

    enclosure_index = 0

    for sd_dev, d in raw.items():
        wwn = d.get("sas_wwn", "")

        if wwn in ("", "none"):
            # No SAS name reported; use a unique pseudo-id so multiple
            # such enclosures are not collapsed into one.
            wwn = "no-sas-wwn-%d" % len(dedup)

        if wwn in dedup:
            continue

        sg_dev = d["sg_dev"]

        dedup[wwn] = dict(d)

        # Determine slot count ONLY for Array device slots
        aes_slots = parse_aes_slots(SysExec("sg_ses --page=aes " + str(sg_dev)))
        drive_slot_indices = sorted(
            idx for (etype, idx, addr) in aes_slots
            if "Array device slot" in etype
        )
        num_slots = len(drive_slot_indices)

        dedup[wwn]["num_slots"] = num_slots
        dedup[wwn]["drive_slot_indices"] = drive_slot_indices
        dedup[wwn]["sg_dev"] = sg_dev

        # Assign Base Alias
        base_alias = "Unknown"
        if num_slots == 24:
            base_alias = "Front"
        elif num_slots == 12:
            base_alias = "Back"
        elif num_slots == 36:
            base_alias = "Unified"
        elif num_slots == 30:
            base_alias = "Valiant"

        if base_alias == "Valiant":
            unique_alias = f"{base_alias}_{enclosure_index + 1}"
            enclosure_index += 1
        else:
            unique_alias = f"{base_alias}"

        dedup[wwn]["alias"] = unique_alias

    Debug("EXIT: map_enclosures", {"count": len(dedup), "wwns": list(dedup.keys()), "aliases": {k: v['alias'] for k, v in dedup.items()}})
    return dedup


def map_enclosure_slots(enclosures):
    Debug("ENTER: map_enclosure_slots")
    slotmap = {}

    for enc_wwn, enc in enclosures.items():

        sg_dev = enc["sg_dev"]

        slotmap[sg_dev] = {}

        aes_slots = parse_aes_slots(SysExec("sg_ses --page=aes " + str(sg_dev)))

        for etype, idx, addr in aes_slots:
            if "Array device slot" not in etype:
                continue
            sas_wwn = "EMPTY" if not addr or addr == "0x0" else addr
            slotmap[sg_dev][str(idx)] = sas_wwn

    Debug("EXIT: map_enclosure_slots", {"sg_devs": list(slotmap.keys()), "sample_slots": {k: list(v.keys())[:3] for k, v in slotmap.items()}})
    return slotmap


# ------------------------------------------------------------------
# Sysfs Fallback Mappers
# ------------------------------------------------------------------

def map_sg_to_enclosure():
    """
    Map /dev/sgN to its sysfs enclosure name.

    /sys/class/scsi_generic/sgN/device and /sys/class/enclosure/<enc>
    both resolve (via realpath) to the SCSI LUN device directory of the
    device they represent, so an sg node belongs to an enclosure iff the
    two resolved paths are equal.
    """
    Debug("ENTER: map_sg_to_enclosure")
    mapping = {}
    enclosure_root = "/sys/class/enclosure"
    if not os.path.isdir(enclosure_root):
        Debug("EXIT: map_sg_to_enclosure (no enclosure root)", mapping)
        return mapping

    sg_root = "/sys/class/scsi_generic"
    try:
        sg_list = os.listdir(sg_root)
    except OSError:
        Debug("EXIT: map_sg_to_enclosure (no scsi_generic)", mapping)
        return mapping

    for enc_name in os.listdir(enclosure_root):
        try:
            enc_path = os.path.realpath(os.path.join(enclosure_root, enc_name))
        except OSError:
            continue
        # /sys/class/enclosure/<enc> resolves to a node two levels below
        # the SCSI device directory, so walk up two levels before
        # comparing against the resolved scsi_generic device path.
        enc_parent = os.path.dirname(os.path.dirname(enc_path))

        for sg in sg_list:
            try:
                sg_path = os.path.realpath(os.path.join(sg_root, sg, "device"))
            except OSError:
                continue
            if sg_path == enc_parent:
                mapping["/dev/" + sg] = enc_name

    Debug("EXIT: map_sg_to_enclosure", mapping)
    return mapping


def map_enclosure_slots_sysfs():
    Debug("ENTER: map_enclosure_slots_sysfs")
    mapping = {}
    enclosure_root = "/sys/class/enclosure"
    if not os.path.isdir(enclosure_root):
        Debug("EXIT: map_enclosure_slots_sysfs (no enclosure root)", mapping)
        return mapping

    for enc_name in os.listdir(enclosure_root):
        enc_path = os.path.join(enclosure_root, enc_name)
        mapping[enc_name] = {}

        try:
            slot_entries = os.listdir(enc_path)
        except OSError:
            continue

        for slot_name in slot_entries:
            slot_path = os.path.join(enc_path, slot_name)
            if not os.path.isdir(slot_path):
                continue

            block_dir = os.path.join(slot_path, "device", "block")
            if not os.path.isdir(block_dir):
                continue

            try:
                devices = sorted(os.listdir(block_dir))
            except OSError:
                continue

            if not devices:
                continue

            dev = "/dev/" + devices[0]
            slot_match = re.search(r"(\d+)", slot_name)
            if not slot_match:
                continue

            mapping[enc_name][int(slot_match.group(1))] = dev

    Debug("EXIT: map_enclosure_slots_sysfs", mapping)
    return mapping


