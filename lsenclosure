def parse_lsblk():
    Debug("ENTER: parse_lsblk")
    m = {}

    for line in SysExec("lsblk -O -P").splitlines():
        if not line.strip():
            continue

        keyval = dict(re.findall(r'(\w+)="([^"]*)"', line))

        if "NAME" not in keyval:
            continue

        name = keyval["NAME"]
        del keyval["NAME"]

        if name.startswith("loop"):
            continue

        m["/dev/" + name] = keyval

    Debug("EXIT: parse_lsblk", {"count": len(m), "sample_keys": list(m.keys())[:3]})
    return m


def parse_lsblk_disks():
    Debug("ENTER: parse_lsblk_disks")
    raw = parse_lsblk()

    disks = {}

    for k in raw.keys():
        # Strictly filter for physical disks only
        if raw[k].get("TYPE") != "disk":
            continue

        disks[k] = raw[k]

    Debug("EXIT: parse_lsblk_disks", {"count": len(disks)})
    return disks


def parse_lsscsi():
    Debug("ENTER: parse_lsscsi")
    """
    Parse `lsscsi -gUN`. Field layout:

        [H:C:T:L] type sas_name devnode scsinode

    e.g.  [2:0:0:0] disk  wwn-0x5000...  /dev/sda  /dev/sg0
          [6:0:0:1] enclosu 0x5006...   -       /dev/sg1

    Enclosures/SES devices have no block device (devnode is "-"); they
    are keyed by their scsinode instead. Rows with too few fields or
    without a usable scsinode are skipped.
    """
    m = {}

    for line in SysExec("lsscsi -gUN").splitlines():

        line = " ".join(line.split())

        fields = line.split()
        if len(fields) < 5:
            continue

        hctl = fields[0].strip("[]")
        type_ = fields[1]
        sas_wwn = fields[2]
        sd_dev = fields[3]
        sg_dev = fields[4]

        if not sg_dev or sg_dev == "-":
            continue

        if not sd_dev or sd_dev == "-":
            # Enclosure/SES device: no block node, key on the sg node
            sd_dev = sg_dev

        m[sd_dev] = {
            "sg_dev": sg_dev,
            "hctl": hctl,
            "sas_wwn": sas_wwn,
            "type": type_,
        }

    Debug("EXIT: parse_lsscsi", {"count": len(m)})
    return m


def parse_lsscsi_disks():
    Debug("ENTER: parse_lsscsi_disks")
    raw = parse_lsscsi()

    out = {}

    for k in raw.keys():

        if raw[k].get("type") != "disk":
            continue

        out[k] = raw[k]

    Debug("EXIT: parse_lsscsi_disks", {"count": len(out)})
    return out


def parse_lsscsi_enclosures():
    Debug("ENTER: parse_lsscsi_enclosures")
    raw = parse_lsscsi()

    out = {}

    for k in raw.keys():

        if raw[k].get("type") != "enclosu":
            continue

        out[k] = raw[k]

    Debug("EXIT: parse_lsscsi_enclosures", {"count": len(out)})
    return out


######################################################################
# SAS WWN HELPERS
######################################################################


AES_SLOT_ADDR_RE = re.compile(r"SAS address: (0x[0-9A-Fa-f]+)")


def parse_aes_slots(ses_output):
    """
    Parse the output of `sg_ses --page=aes` into a list of
    (element_type, element_index, sas_address) tuples.

    The "SAS address:" line for each element follows its "Element index:"
    line; "attached SAS address:" lines (the address of the device
    attached to the slot, repeated elsewhere) are ignored, as is the
    enclosure header's "SAS address (in hex):" line. Elements without
    an address line are omitted.
    """
    slots = []
    current_type = ""
    pending_index = None

    for line in ses_output.splitlines():
        if "Element type:" in line:
            parts = line.split(":", 1)
            current_type = parts[1].strip() if len(parts) > 1 else ""
            pending_index = None
            continue

        if "Element index:" in line:
            parts = line.split(":", 1)
            try:
                pending_index = int(parts[1].split()[0])
            except (ValueError, IndexError):
                pending_index = None
            continue

        if "attached SAS address" in line:
            continue

        m = AES_SLOT_ADDR_RE.search(line)
        if m and pending_index is not None:
            slots.append((current_type, pending_index, m.group(1)))
            pending_index = None

    return slots


######################################################################
# WWN AGGREGATION
######################################################################


def aggregate_physical_disks(map_lsblk):
    Debug("ENTER: aggregate_physical_disks")
    """
    Group all paths to the same physical disk by WWN. Drives without a
    WWN cannot be grouped and are excluded (callers fall back to the
    per-device data).
    """

    physical = {}

    for sd_dev, d in map_lsblk.items():

        wwn = (d.get("WWN", "") or "").strip()
        if not wwn:
            continue

        if wwn not in physical:
            physical[wwn] = {**d, "DEVICES": [sd_dev], "SG_DEVICES": []}

            if d.get("sg_dev"):
                physical[wwn]["SG_DEVICES"].append(d["sg_dev"])

        else:
            physical[wwn]["DEVICES"].append(sd_dev)

            if d.get("sg_dev") and d["sg_dev"] not in physical[wwn]["SG_DEVICES"]:
                physical[wwn]["SG_DEVICES"].append(d["sg_dev"])

            #
            # Prefer entries with enclosure data
            #
            for key in ("slot", "backplane", "bp_alias"):
                if d.get(key) and not physical[wwn].get(key):
                    physical[wwn][key] = d[key]

            # Ensure we keep the data from the TYPE=disk entry
            if d.get("TYPE") == "disk" and physical[wwn].get("TYPE") != "disk":
                keep = {}
                for key in ("DEVICES", "SG_DEVICES", "slot", "backplane", "bp_alias"):
                    if physical[wwn].get(key) and not d.get(key):
                        keep[key] = physical[wwn][key]
                physical[wwn] = {**d, **keep}

    Debug("EXIT: aggregate_physical_disks", {"count": len(physical)})
    return physical


