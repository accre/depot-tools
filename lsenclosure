"""
lsenclosure - List block devices attached to a storage backplane
"""

import re
import os
import sys
import time
import subprocess

from subprocess import Popen, PIPE, STDOUT
from shutil import which

_CACHE = {}

PRINT_DEBUG = False

def Debug(*args):
    """Accepts one or more arguments. Prints dicts key-by-value, others as strings."""
    if not PRINT_DEBUG:
        return
    for arg in args:
        if isinstance(arg, dict):
            for k in arg.keys():
                print("DEBUG: " + str(k) + " - " + str(arg[k]))
        else:
            print("DEBUG: " + str(arg))


def _run(argv, timeout=10):
    """
    Run argv (list form, no shell). Returns (returncode, combined_output).
    Never raises: OS errors and timeouts are reported via the return code.
    """
    try:
        proc = Popen(argv, stdout=PIPE, stderr=STDOUT)
    except OSError as e:
        return 127, "ERROR: could not run %s: %s" % (" ".join(argv), e)
    try:
        out, _ = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        try:
            proc.communicate()
        except Exception:
            pass
        return 124, ""
    text = out.decode("utf-8", "replace") if isinstance(out, bytes) else (out or "")
    return proc.returncode, text


def SysExec(cmd, timeout=10):
    """
    Run a whitespace-separated command (no shell features) and return the
    combined stdout/stderr text. Output is cached for 20 seconds.
    The exit code is not propagated; callers inspect the returned text.
    """
    CACHE_TTL = 20
    now = time.time()
    if cmd in _CACHE and now - _CACHE[cmd][0] < CACHE_TTL:
        return _CACHE[cmd][1]
    rc, out = _run(cmd.split(), timeout=timeout)
    if rc != 0:
        Debug("SysExec: rc=%d cmd=%s output=%r" % (rc, cmd, out[:200]))
    _CACHE[cmd] = (now, out)
    return out


def Bin_Requires(bin):
    bin_path = which(bin)
    if not bin_path:
        print("ERROR: Could not locate " + bin + " in the PATH")
        sys.exit(1)
    return bin_path


# Check for required binaries
for bin in ("sg_ses", "sg_vpd", "lsblk", "lsscsi"):
    Bin_Requires(bin)


