# Enclosure Detection
# ------------------------------------------------------------------

def enclosures_exist():
    """
    Check whether any storage enclosures are present.

    Method 1 - lsscsi -g, look for a device whose TYPE column is "enclosu"
    Method 2 - scan /sys/class/enclosure (ignoring the VirtualSES
               pseudo-enclosure)
    """
    # Method 1: lsscsi -g (pipe handled in Python, not via shell)
    if which("lsscsi"):
        for line in SysExec("lsscsi -g").splitlines():
            fields = line.split()
            if len(fields) >= 2 and fields[1] == "enclosu":
                Debug("Enclosure detected via lsscsi")
                return True

    # Method 2: sysfs
    enc_root = "/sys/class/enclosure"
    if os.path.isdir(enc_root):
        try:
            entries = [e for e in os.listdir(enc_root) if e != "VirtualSES"]
            if entries:
                Debug("Enclosure detected via sysfs:", entries)
                return True
        except OSError:
            pass

    return False


