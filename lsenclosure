def is_multipath_enabled():
    if not which("multipath"):
        return(False)
    multipath_ll = SysExec("multipath -ll")
    if re.search("DM multipath kernel driver not loaded", multipath_ll):
        return(False)
    lines = [l for l in multipath_ll.splitlines() if l.strip()]
    if not lines:
        return(False)
    # `multipath -ll` with no paths prints only "multipath: error: ..."
    # banner lines; a real multipath map has at least one other line.
    if all(re.search(r"^multipath.*\berror\b", l, re.IGNORECASE) for l in lines):
        return(False)
    return True

def map_dm_to_mpath():
    """
    Map "dm-N" -> "/dev/mapper/<name>" for multipath devices.
    Reads the /dev/mapper symlinks directly instead of parsing `ls`
    output, and returns an empty map if /dev/mapper does not exist.
    """
    Debug("def map_dm_to_mpath() entry")
    dev_map = {}
    mapper_dir = "/dev/mapper"
    if not os.path.isdir(mapper_dir):
        return(dev_map)
    try:
        entries = os.listdir(mapper_dir)
    except OSError:
        return(dev_map)
    for entry in entries:
        if not re.search("mpath", entry):
            continue
        try:
            target = os.readlink(os.path.join(mapper_dir, entry))
        except OSError:
            continue
        # target is a relative path like "../dm-3"
        m = re.match(r"\.\./dm-(\d+)$", target)
        if m:
            dev_map["dm-" + m.group(1)] = entry
    return(dev_map)

def map_Dev_to_RID(multipath_active):
    Debug("def map_Dev_to_RID() entry")
    Map = {}
    by_label = "/dev/disk/by-label"
    if not os.path.isdir(by_label):
        Debug("map_Dev_to_RID: " + by_label + " not present")
        return(Map)

    map_dm_mpath = map_dm_to_mpath() if multipath_active else {}

    try:
        entries = os.listdir(by_label)
    except OSError:
        return(Map)

    for entry in entries:
        if not entry.startswith("rid-data-"):
            continue

        try:
            target = os.readlink(os.path.join(by_label, entry))
        except OSError:
            continue

        # target is a relative path like "../dm-3" or "../sda1"
        name = target.split("/")[-1]

        # Strip a trailing partition number (sda1 -> sda); whole-disk
        # names such as dm-3 are left alone.
        if re.match(r"^sd[a-z]+\d+$", name):
            name = re.sub(r"[0-9]+$", "", name)

        # Label scheme: rid-data-<N>
        parts = entry.split("-")
        This_Rid = parts[2] if len(parts) >= 3 else entry

        if multipath_active and name.startswith("dm-"):
            mpath_name = map_dm_mpath.get(name)
            if mpath_name:
                name = "/dev/mapper/" + mpath_name

        Map["/dev/" + name] = This_Rid
    return(Map)

def GetLocateLEDState_safe(backplane, slot):
    if backplane is None or slot is None:
        return("UNKNOWN")
    This_LedState = SysExec("sg_ses -I " + str(slot) + " --get=ident " + str(backplane)).strip()
    LedState_Descr = "Unknown"
    if This_LedState == "1":
        LedState_Descr = "On"
    if This_LedState == "0":
        LedState_Descr = "Off"
    return(LedState_Descr)

######################################################################
# CUSTOM TABLE FORMATTER
######################################################################

def format_table(headers, rows):
    """
    Prints a simple ASCII table without prettytable dependency.
    """
    if not rows:
        return

    # Calculate column widths
    col_widths = [len(str(h)) for h in headers]

    for row in rows:
        for i, val in enumerate(row):
            str_val = str(val) if val is not None else ""
            if i < len(col_widths):
                col_widths[i] = max(col_widths[i], len(str_val))

    # Create separator line
    separator = "+" + "+".join("-" * (w + 2) for w in col_widths) + "+"

    # Print Header
    header_row = "|" + "|".join(f" {str(h).ljust(col_widths[i])} " for i, h in enumerate(headers)) + "|"
    print(separator)
    print(header_row)
    print(separator)

    # Print Rows
    for row in rows:
        row_str = "|" + "|".join(f" {str(val).ljust(col_widths[i])} " for i, val in enumerate(row)) + "|"
        print(row_str)

    print(separator)

